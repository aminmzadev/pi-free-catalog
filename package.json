{
  "name": "pi-free-catalog",
  "version": "0.1.7",
  "description": "Live, auditable anonymous Kilo, OpenCode and OVHcloud model catalogs for Pi. No account or name-based free filtering.",
  "type": "module",
  "license": "MIT",
  "author": "Amin Mozaffari <aminmozaffari1185@gmail.com>",
  "keywords": [
    "pi-package",
    "pi",
    "kilo",
    "opencode",
    "free-models",
    "ovhcloud"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./index.js"
    ]
  },
  "exports": {
    ".": "./index.js",
    "./catalog": "./src/catalog.js"
  },
  "files": [
    "index.js",
    "src/*.js",
    "test/*.mjs",
    "test/fixtures/*.gz",
    "test/fixtures/manifest.json",
    "scripts/*.mjs",
    "scripts/*.js",
    "scripts/*.py",
    "README.md",
    "REFERENCE.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "catalog": "node scripts/catalog.mjs",
    "verify": "npm run check && npm test && npm pack --dry-run --ignore-scripts",
    "prepublishOnly": "npm run verify",
    "verify:local-loader": "node scripts/verify-local-loader.mjs",
    "test:footer-monkey": "node --test test/footer-monkey.test.mjs",
    "test:pool-monkey": "node --test test/free-pool-monkey.test.mjs",
    "verify:general-loader": "node scripts/verify-general-loader.mjs",
    "test:pool-diagnostics-monkey": "node --test test/free-pool-diagnostics-monkey.test.mjs",
    "test:pool-continuity-monkey": "node --test test/free-pool-continuity-monkey.test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aminmzadev/pi-free-catalog.git"
  },
  "homepage": "https://github.com/aminmzadev/pi-free-catalog#readme",
  "bugs": {
    "url": "https://github.com/aminmzadev/pi-free-catalog/issues"
  }
}
